# Local real-engine development. Use absolute paths for the model and config.
KATAGO_PATH=katago
KATAGO_MODEL_PATH=/absolute/path/to/model.bin.gz
KATAGO_CONFIG_PATH=/absolute/path/to/config/analysis.cfg
KATAGO_MAX_VISITS=200

# The public container sets its own production defaults. These values are only
# useful when testing app.production directly outside Fly.io.
GO_REVIEW_PUBLIC=1
GO_REVIEW_PUBLIC_HOSTS=["localhost:8080"]
GO_REVIEW_RELEASE=unreleased
GO_REVIEW_CLIENT_IP_HEADER=
GO_REVIEW_ALLOWED_ORIGINS=[]
